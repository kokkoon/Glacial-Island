# Glacial-Island. Copy to .env and fill in real values; never commit .env.
PORT=4000
NODE_ENV=development
LOCAL_DEV=
LOCAL_GLOZIC_URL=
PORTAL_DEV_HOST=
PORTAL_LIVE_HOST=
WORKFLOW_API_URL=

# Redis (Bull queues and scheduler coordination). Local: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=
REDIS_PORT=
REDIS_PWD=
REDIS_USER=

SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

AS400_JOB_TIMEOUT_MS=
AS400_POLL_INTERVAL_MS=
IBMI_HOST=
IBMI_PORT=
IBMI_DATABASE=
IBMI_LIBRARY=
IBMI_ODBC_DRIVER=
IBMI_USER=
IBMI_PASSWORD=

# --- Scheduler ---
SCHEDULER_ENABLED=true
# glozic-stagging base URL without /api (local: http://localhost:5000).
GLOZIC_STAGGING_BASE_URL=http://localhost:5000
# Same value as SCHEDULER_INTERNAL_TOKEN in glozic-stagging (at least 32 characters).
SCHEDULER_INTERNAL_TOKEN=
# Optional tuning (defaults shown; values are clamped to safe ranges).
SCHEDULER_POLL_INTERVAL_MS=15000
SCHEDULER_BATCH_SIZE=10
SCHEDULER_MAX_CONCURRENCY=5
SCHEDULER_MAX_TENANT_CONCURRENCY=2
SCHEDULER_LOCK_TTL_MS=60000
SCHEDULER_LEASE_MS=300000
SCHEDULER_HTTP_TIMEOUT_MS=30000
SCHEDULER_WEBSERVICE_TIMEOUT_MS=15000
SCHEDULER_WEBSERVICE_MAX_RESPONSE_BYTES=1048576
SCHEDULER_CATCHUP_GRACE_MS=3600000
SCHEDULER_REGISTRY_REFRESH_MS=300000
SCHEDULER_SHUTDOWN_GRACE_MS=20000
# Comma-separated hostnames that CALL_WEB_SERVICE may reach even though they resolve to private
# addresses (for example 127.0.0.1 for a local test endpoint). Keep empty in staging.
SCHEDULER_WEBSERVICE_ALLOW_PRIVATE_HOSTS=
